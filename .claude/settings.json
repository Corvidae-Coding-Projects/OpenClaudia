{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/post-edit-check.py",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(Write|Edit|write_file|edit_file)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/work-check.py",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "^(Write|Edit|Bash|write_file|edit_file|bash)$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(startup|resume|session_start)$"
      }
    ]
  }
}
